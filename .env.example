# reet.sh settings. `docker compose` reads a file named .env in this folder automatically.
#
# Easiest setup: run `sh scripts/init-env.sh` to create .env from this file, generate a
# token, set REET_UID/REET_GID to your user and create the data folder.

# Host folder that holds the database (bind-mounted into the container at /data).
# It must exist and be writable by REET_UID:REET_GID.
REET_DATA_PATH=./data

# The container runs as this user, so the data folder stays owned by you.
# Fill in with:  id -u  and  id -g
REET_UID=1000
REET_GID=1000

# Host port for the web UI.
REET_PORT=8080

# Image tag: latest, dev, a release such as v1.0.0, or sha-<short>.
REET_VERSION=latest

# Authentication mode: accounts (default; set up an owner), token (the single REET_TOKEN)
# or none (only on a network you fully trust).
REET_AUTH=accounts

# In accounts mode this is the setup bootstrap and fallback scan token until a personal
# API token exists; in token mode it is the only credential. Empty means no token.
# Generate one:  openssl rand -hex 32
REET_TOKEN=

# Optional: skills.sh API token. It needs a Vercel OIDC token and cannot be generated here.
# Without it, reet reads the public skills.sh pages instead.
SKILLS_SH_TOKEN=

# Set to debug for one line per metadata fetch and per background result.
REET_LOG=

# Set to off to stop the daily skills.sh topic seed (nine read-only page fetches a day).
REET_TOPICS=

# Set to off to stop the six-hourly metadata refresh (the 50 oldest skills, two seconds apart).
REET_REFRESH=

# Optional remote controller for a server process. Use a PERSONAL token from that
# controller account, not this server's bootstrap token. Reports once per minute.
REET_CONTROLLER_URL=
REET_CONTROLLER_TOKEN=
# Stable host alias for scan/sync/server reports; defaults to the hostname.
REET_ENV=

# --- Backups ----------------------------------------------------------------
# Sealed copies of the database (owner) and of each person's own shelf.
# Set REET_BACKUP_KEY to a value from `reet backup keygen`, or leave it empty
# and reet generates data/backup.key on first start. Keep a copy of the key
# away from this machine: the off-site copies cannot be opened without it.
REET_BACKUP_KEY=
# Where copies are kept on this machine. Default: the data folder's backups/.
REET_BACKUP_DIR=
# Instance schedule and retention. 0 turns the schedule off; 0 copies kept
# means keep every one.
REET_BACKUP_EVERY=24h
REET_BACKUP_KEEP=48
# Where copies go by default: local, remote or both. Each owner can change it.
REET_BACKUP_DESTINATION=both
# Compress copies before sealing: gzip or none. Each owner can change it.
REET_BACKUP_COMPRESSION=gzip
# Defaults for a person's own backups (manual unless they set a schedule).
REET_BACKUP_USER_EVERY=0
REET_BACKUP_USER_KEEP=14

# One off-site destination can come from the environment, which is what a
# machine rebuilt from nothing can still read. More destinations are added in
# Admin -> Backups. Use an S3-compatible endpoint (AWS, R2, B2, MinIO, Garage).
REET_BACKUP_S3_ENDPOINT=
REET_BACKUP_S3_REGION=
REET_BACKUP_S3_BUCKET=
REET_BACKUP_S3_PREFIX=reet/
REET_BACKUP_S3_ACCESS_KEY_ID=
REET_BACKUP_S3_SECRET_ACCESS_KEY=
# true, false, or empty to choose from the endpoint.
REET_BACKUP_S3_PATH_STYLE=
REET_BACKUP_S3_NAME=offsite
# Allow an http:// endpoint on another machine. Not recommended: the access key
# id travels in the clear, though the backups themselves are sealed.
REET_BACKUP_ALLOW_LOCAL=
