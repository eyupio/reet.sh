[0.0347, "o", "\u001b[>4m\u001b[?1049h\u001b[?25l\u001b[?5W\u001b[?2004h\u001b[>4;2m\u001b[>1u\u001b[?u\u001b[H\u001b[2J\u001b[1mreet\u001b[38;2;251;146;60;22m.sh\u001b[m\u001b[66X\u001b[74G\u001b[38;2;156;163;175mdev\u001b[m\r\n\u001b[38;2;156;163;175mGet your toolkit reet.\u001b[m\r\n\n\u001b[38;2;156;163;175m  CHECK & MAINTAIN\u001b[m\r\n\u001b[38;2;251;146;60m\u203a Doctor            \u001b[38;2;156;163;175mCheck this installation\u001b[m\r\n  Healthcheck       \u001b[38;2;156;163;175mCheck a server's /healthz\u001b[m\r\n  Upgrade           \u001b[38;2;156;163;175mCheck, verify and install a release\u001b[m\r\n  Backups           \u001b[38;2;156;163;175mList, take and restore sealed copies\u001b[m\r\n\n\u001b[38;2;156;163;175m  SKILLS & SETUPS\u001b[m\r\n  Scan\u001b[14X\u001b[11;21H\u001b[38;2;156;163;175mReport installed skills to your account\u001b[m\r\n  Sync\u001b[14X\u001b[12;21H\u001b[38;2;156;163;175mPreview a saved target; --apply asks first\u001b[m\r\n  Setups            \u001b[38;2;156;163;175mDiscover, save and restore agent setups\u001b[m\r\n\n\u001b[38;2;156;163;175m  MACHINES & ACCESS\u001b[m\r\n  Connect machine   \u001b[38;2;156;163;175mEnroll with a controller\u001b[m\r\n  Agent status      \u001b[38;2;156;163;175mThis machine's enrollment and daemon\u001b[m\r\n  Terminal          \u001b[38;2;156;163;175mManage controller terminal access\u001b[m\r\n\n\u001b[38;2;156;163;175m  MORE COMMANDS\u001b[m\r\n  Configure         \u001b[38;2;156;163;175mSave connection and release defaults\u001b[m\r\n  Install           \u001b[38;2;156;163;175mSet up a binary or managed deployment\u001b[m\r\n  Serve             \u001b[38;2;156;163;175mRun the web app (also the non-interactive default)\u001b[m\r\n  Version           \u001b[38;2;156;163;175mBinary version and source commit\u001b[m\r\n  Help\u001b[14X\u001b[25;21H\u001b[38;2;156;163;175mRead the command reference\u001b[m\r\n\n\u2191/\u2193 j/k move   Enter open   / search\r\ne edit   ? help   Esc back   q quit"]
