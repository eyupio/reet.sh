diff --git a/.github/workflows/image.yml b/.github/workflows/image.yml
index df56e32..ae2f935 100644
--- a/.github/workflows/image.yml
+++ b/.github/workflows/image.yml
@@ -4,7 +4,23 @@ on:
   push:
     branches: [main]
     tags: ["v*"]
+  # This job is the full suite (web check, MCP tests, go vet, go test -race ./...), so it has to run whenever anything
+  # it compiles could change. Documentation, brand artwork and the other workflows are not compiled into the binary or
+  # the image, so a pull request that only touches those does not need a 20-minute Go run. Pushes and tags stay
+  # unfiltered: every image that is published has been tested.
   pull_request:
+    paths:
+      - 'cmd/**'
+      - 'internal/**'
+      - 'web/**'
+      - 'mcp/**'
+      - 'scripts/**'
+      - 'go.mod'
+      - 'go.sum'
+      - 'Dockerfile'
+      - '.dockerignore'
+      - 'docker-compose.yml'
+      - '.github/workflows/image.yml'
   workflow_dispatch:
 
 permissions:
diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 3e718ec..8341d21 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -75,6 +75,10 @@ jobs:
           include-hidden-files: true
 
   verify:
+    # image.yml already runs `go vet ./... && go test -race ./...` on every pull request, so repeating the same suite
+    # here doubled the cost of each code pull request without adding a check. Packaging still runs on pull requests
+    # (web, build), and every release event keeps the full gate before publish can run.
+    if: github.event_name != 'pull_request'
     needs: [source, web]
     runs-on: zoomies-linux-x64
     steps:
@@ -92,13 +96,18 @@ jobs:
       - run: go vet ./... && go test -race -timeout=20m ./...
 
   build:
-    needs: [source, web, verify]
+    # Only web is needed to package: the Go sources come from the checkout, not from verify. Waiting for verify made
+    # every release event take the tests and the archives one after the other; publish still waits for both.
+    needs: [source, web]
     runs-on: zoomies-linux-x64
     strategy:
       fail-fast: false
       matrix:
-        os: [linux, darwin]
-        arch: [amd64, arm64]
+        # A pull request proves the packaging path once. macOS is not lost: native-services and private-connection
+        # compile and test the same Go code on macos-latest at pull request time. Releases still build every target
+        # before publishing, so nothing untested can ship.
+        os: ${{ fromJSON(github.event_name == 'pull_request' && '["linux"]' || '["linux","darwin"]') }}
+        arch: ${{ fromJSON(github.event_name == 'pull_request' && '["amd64"]' || '["amd64","arm64"]') }}
     steps:
       - uses: actions/checkout@v4
         with:
@@ -127,13 +136,16 @@ jobs:
           tar --sort=name --mtime="@$REET_EPOCH" --owner=0 --group=0 --numeric-owner \
             -cf - -C staging reet LICENSE README.md | gzip -n > "artifacts/reet_${version}_${GOOS}_${GOARCH}.tar.gz"
       - uses: actions/upload-artifact@v4
+        # Publish is what consumes these archives, and it never runs for a pull request. Uploading there only left
+        # artifacts for the cleanup workflow to prune later.
+        if: github.event_name != 'pull_request'
         with:
           name: binary-${{ matrix.os }}-${{ matrix.arch }}
           path: artifacts/*
 
   publish:
-    if: startsWith(github.ref, 'refs/tags/') || github.event_name == 'workflow_dispatch' || github.ref == 'refs/heads/main'
-    needs: [source, build]
+    if: (startsWith(github.ref, 'refs/tags/') || github.event_name == 'workflow_dispatch' || github.ref == 'refs/heads/main') && needs.verify.result == 'success'
+    needs: [source, build, verify]
     runs-on: zoomies-linux-x64
     permissions:
       contents: write
